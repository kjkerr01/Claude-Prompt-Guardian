{
  "manifest_version": 3,
  "name": "Claude Age-Gate Guardian",
  "version": "1.1",
  "description": "Intercepts Claude prompts and checks them with Gemma before sending.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://claude.ai/*",
    "*://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["*://claude.ai/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardian Settings"
  }
}
